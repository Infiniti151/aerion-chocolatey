    <bugTrackerUrl>https://github.com/hkdb/aerion/issues</bugTrackerUrl>
    <docsUrl>https://aerion.3df.io/docs/intro</docsUrl>
  </metadata>

  <files>
    <file src="tools\**" target="tools" exclude="tools\.skipAutoUninstall" />
    <file src="tools\.skipAutoUninstall" target="tools\.skipAutoUninstall" />
    <file src="legal\**" target="legal" />
  </files>
</package>
